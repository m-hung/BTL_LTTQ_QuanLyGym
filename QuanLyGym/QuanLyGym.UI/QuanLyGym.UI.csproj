<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuanLyGym.BLL\QuanLyGym.BLL.csproj" />
    <ProjectReference Include="..\QuanLyGym.DAL\QuanLyGym.DAL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Forms\Admin\" />
    <Folder Include="Forms\Member\" />
    <Folder Include="Forms\Common\" />
    <Folder Include="Forms\PT\" />
  </ItemGroup>

</Project>